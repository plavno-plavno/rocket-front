{
  "name": "@lp/contracts",
  "version": "0.2.0",
  "private": true,
  "description": "Contracts of the Local Presence Platform: core-api OpenAPI 3.1 (+ generated TS types), inter-service events (AsyncAPI 3), Job API JSON Schema and the Connector SPI (SDD-00). To be moved to the contracts repository.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./openapi": "./src/openapi.ts",
    "./core-api.yaml": "./openapi/core-api.yaml",
    "./events": "./src/events.ts",
    "./jobs": "./src/jobs.ts",
    "./spi": "./src/spi.ts",
    "./asyncapi.yaml": "./events/asyncapi.yaml",
    "./job-api.schema.json": "./jobs/job-api.schema.json"
  },
  "files": [
    "openapi",
    "events",
    "jobs",
    "src"
  ],
  "scripts": {
    "gen": "openapi-typescript openapi/core-api.yaml -o src/generated/core-api.d.ts --alphabetize --root-types --root-types-no-schema-prefix --empty-objects-unknown",
    "gen:check": "node scripts/gen-check.mjs",
    "lint": "redocly lint openapi/core-api.yaml",
    "lint:strict": "redocly lint openapi/core-api.yaml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "echo skip",
    "format:check": "echo skip"
  },
  "devDependencies": {
    "@redocly/cli": "^2.5.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "5.7.2",
    "yaml": "^2.8.1"
  }
}
