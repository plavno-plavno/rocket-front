# ── core-api ─────────────────────────────────────────────────────────────────
# Server-side base URL of core-api. In development this is the mock server (pnpm mock:api).
CORE_API_URL=http://localhost:4010
# Port of the mock server (pnpm mock:api). Worktree tracks use 4100+n (SDD-01T §3.9).
MOCK_PORT=4010
# Multiplier for simulated latency in the mock server (0 disables).
MOCK_LATENCY=1

# ── build ────────────────────────────────────────────────────────────────────
# Set to 'true' for Docker / self-hosting (Next.js standalone output).
BUILD_STANDALONE=

# ── Sentry (off by default) ──────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DISABLED="true"
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ORG=
NEXT_PUBLIC_SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
