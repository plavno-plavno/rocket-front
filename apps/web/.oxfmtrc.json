{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSpacing": true,
  "semi": true,
  "useTabs": false,
  "trailingComma": "none",
  "jsxSingleQuote": true,
  "singleQuote": true,
  "tabWidth": 2,
  "endOfLine": "lf",
  "experimentalSortTailwindcss": true,
  "ignorePatterns": [
    ".next/**",
    "test-results/**",
    "playwright-report/**",
    "out/**",
    "build/**",
    "node_modules/**",
    "scripts/**",
    "pnpm-lock.yaml",
    "**/*.md",
    "**/*.mdc",
    "**/*.mdx",
    "**/*.yml",
    "**/*.yaml"
  ]
}
